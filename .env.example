# ─── Supabase ───────────────────────────────────────────────
# Project URL + anon key (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — server-side only, NEVER expose to client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Anthropic (landing analysis + draft generation) ────────
ANTHROPIC_API_KEY=sk-ant-...
# Landing-analysis model (override only if needed)
ANTHROPIC_MODEL_ANALYZE=claude-haiku-4-5-20251001

# ─── Platega (balance top-ups: SBP / RU cards / Sberpay / crypto / intl card) ──
# Merchant id + API key from the Platega dashboard (Settings). Callback URL to
# set there: https://<your-domain>/api/webhooks/platega
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
# RUB charged per $1 of balance. Set ABOVE market so the 1–5% provider fee and
# RUB volatility are covered (e.g. market 90 → 97). Billing stays off until set.
PLATEGA_RUB_PER_USD=
# Optional: force one method (2 SBP, 11 RU card, 12 international, 13 crypto,
# 14 Sberpay). Unset = payer picks the method on Platega's page.
PLATEGA_PAYMENT_METHOD=

# ─── Apify (Reddit data: thread search, karma check, community scan) ────
# ⚠️ See brain/Reddit Compliance (BLOCKER).md before enabling in production.
APIFY_TOKEN=

# ─── Global daily budget caps (lib/budget.ts, migration 0017) ────────────
# Ceilings across ALL accounts per day — protects the Anthropic/Apify bill from
# account farming. Defaults: 100 analyses, 40 Apify runs, 2 admin scans.
ANALYZE_GLOBAL_PER_DAY=
APIFY_GLOBAL_PER_DAY=
APIFY_SCANS_PER_DAY=

# ─── Telegram operator alerts (new sign-ups) ────────────────
# Bot token from @BotFather; chat id = your own chat with the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Limits: 2 maps/account (lib/billing.ts), 15 analyses/day (api/analyze).
# Hours to cache an identical URL run before spending new AI calls
URL_CACHE_HOURS=24
# Admin allowlist — any one is enough. Prefer user ids (Supabase → Auth → Users).
ADMIN_USER_IDS=
# GitHub logins, matched against the OAuth identity (never user_metadata)
ADMIN_USERNAMES=
# Emails (GitHub only exposes an email if it's public on GitHub)
ADMIN_EMAILS=
# Public site origin used for payment return URLs (defaults to request origin)
NEXT_PUBLIC_SITE_URL=
